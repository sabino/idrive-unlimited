+++ b/internal/webdav/audit_test.go
@@ -0,0 +1,96 @@
+package idrivewebdav
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/cookiejar"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	netwebdav "golang.org/x/net/webdav"
+	"idrive-unlimited/internal/evs"
+)
+
+func TestAuditCacheSeparatesAccountsOnSameServer(t *testing.T) {
+	t.Setenv(cacheDirEnv, t.TempDir())
+	newAccount := func(value string) *FileSystem {
+		jar, _ := cookiejar.New(nil)
+		u, _ := url.Parse("https://same-server.idrive.com/")
+		jar.SetCookies(u, []*http.Cookie{{Name: "EVSID", Value: value}})
+		c, _ := evs.NewClient(u.Host, jar)
+		return New(c, "/")
+	}
+	a, b := newAccount("account-a"), newAccount("account-b")
+	node := evs.Node{Path: "/test.txt", Name: "test.txt", Size: 5, Version: "1", ModTime: time.Unix(1700000000, 0)}
+	if _, err := a.cache.Ensure(context.Background(), &fakeDownloader{payload: []byte("ALICE")}, node.Path, node); err != nil {
+		t.Fatal(err)
+	}
+	dl := &fakeDownloader{payload: []byte("BOB!!")}
+	p, err := b.cache.Ensure(context.Background(), dl, node.Path, node)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "BOB!!" {
+		t.Fatalf("account B read account A's cached data %q; B downloads=%d", got, dl.calls)
+	}
+}
+
+type auditBrokenBody struct{ sent bool }
+
+func (b *auditBrokenBody) Read(p []byte) (int, error) {
+	if b.sent {
+		return 0, io.ErrUnexpectedEOF
+	}
+	b.sent = true
+	return copy(p, "partial"), nil
+}
+func (b *auditBrokenBody) Close() error { return nil }
+
+func TestAuditInterruptedPutDoesNotUploadPartialData(t *testing.T) {
+	uploaded := ""
+	s := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/evs/browseFolder":
+			io.WriteString(w, `{"message":"SUCCESS","path":"/","contents":[]}`)
+		case "/evs/web/upload":
+			if err := r.ParseMultipartForm(1024 * 1024); err != nil {
+				t.Error(err)
+				return
+			}
+			f, _, err := r.FormFile("file")
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer f.Close()
+			data, _ := io.ReadAll(f)
+			uploaded = string(data)
+			io.WriteString(w, `{"message":"SUCCESS"}`)
+		default:
+			t.Errorf("unexpected endpoint %s", r.URL.Path)
+		}
+	}))
+	defer s.Close()
+	oldTransport := http.DefaultTransport
+	http.DefaultTransport = s.Client().Transport
+	defer func() { http.DefaultTransport = oldTransport }()
+	c, _ := evs.NewClient(strings.TrimPrefix(s.URL, "https://"), nil)
+	h := &netwebdav.Handler{FileSystem: New(c, "/"), LockSystem: netwebdav.NewMemLS()}
+	r := httptest.NewRequest(http.MethodPut, "http://gateway/new.txt", nil)
+	r.Body = &auditBrokenBody{}
+	r.ContentLength = 100
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if uploaded != "" {
+		t.Fatalf("aborted PUT returned HTTP %d but committed partial remote content %q", w.Code, uploaded)
+	}
+}
