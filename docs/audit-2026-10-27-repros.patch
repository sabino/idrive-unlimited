@@ -0,0 +1,45 @@
+package session
+
+import (
+	"net/http"
+	"net/http/cookiejar"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAuditSaveRestrictsExistingSessionFile(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "session.json")
+	if err := os.WriteFile(p, []byte("{}"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	s := &Store{Path: p}
+	if err := s.Save(&Data{ServerHost: "example.com"}); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0600 {
+		t.Fatalf("saved authentication cookies retain permissions %o, want 600", info.Mode().Perm())
+	}
+}
+
+func TestAuditCookieRoundTripPreservesSameNameDifferentPaths(t *testing.T) {
+	jar, _ := cookiejar.New(nil)
+	u, _ := url.Parse("https://example.com/evs/")
+	jar.SetCookies(u, []*http.Cookie{{Name: "SESSION", Value: "root", Path: "/"}, {Name: "SESSION", Value: "evs", Path: "/evs/"}})
+	data, err := FromCookieJar("example.com", jar)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored, err := data.NewCookieJar()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := restored.Cookies(u); len(got) != 2 {
+		t.Fatalf("cookie round trip lost path-specific session: got %v, want both root and EVS values", got)
+	}
+}
diff --git a/internal/webdav/audit_test.go b/internal/webdav/audit_test.go
