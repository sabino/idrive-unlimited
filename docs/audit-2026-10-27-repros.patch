+package evs
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func auditClient(t *testing.T, handler http.HandlerFunc) *Client {
+	t.Helper()
+	s := httptest.NewServer(handler)
+	t.Cleanup(s.Close)
+	c, err := NewClient("audit.invalid", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.baseURL = s.URL
+	return c
+}
+
+func TestAuditCopyRefreshesCachedDestination(t *testing.T) {
+	copied := false
+	browses := 0
+	c := auditClient(t, func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/evs/browseFolder":
+			browses++
+			contents := []map[string]any{}
+			if copied {
+				contents = append(contents, map[string]any{"name": "source.txt", "size": "3"})
+			}
+			json.NewEncoder(w).Encode(map[string]any{"message": "SUCCESS", "path": "/dest", "contents": contents})
+		case "/evs/copyPasteFileFolder":
+			copied = true
+			fmt.Fprint(w, `{"message":"SUCCESS"}`)
+		default:
+			t.Errorf("unexpected endpoint %s", r.URL.Path)
+		}
+	})
+	if _, err := c.Browse(context.Background(), "/dest"); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+	defer cancel()
+	if err := c.Copy(ctx, "/source.txt", "/dest"); err != nil {
+		t.Fatalf("copy was completed upstream but returned %v; browse calls=%d (cached destination was never refreshed)", err, browses)
+	}
+}
+
+func TestAuditFailedOverwritePreservesOriginal(t *testing.T) {
+	deleted := false
+	c := auditClient(t, func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/evs/browseFolder":
+			fmt.Fprint(w, `{"message":"SUCCESS","path":"/","contents":[{"name":"old.txt","size":"8"}]}`)
+		case "/evs/v1/deleteFile":
+			deleted = true
+			fmt.Fprint(w, `{"message":"SUCCESS"}`)
+		case "/evs/web/upload":
+			http.Error(w, "injected upload failure", http.StatusServiceUnavailable)
+		default:
+			t.Errorf("unexpected endpoint %s", r.URL.Path)
+		}
+	})
+	local := filepath.Join(t.TempDir(), "replacement.txt")
+	if err := os.WriteFile(local, []byte("new data"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.UploadFile(context.Background(), local, "/old.txt", time.Now()); err == nil {
+		t.Fatal("expected injected upload failure")
+	}
+	if deleted {
+		t.Fatal("original file was permanently deleted before replacement upload failed")
+	}
+}
+
+func TestAuditHTMLUploadReplyIsRejected(t *testing.T) {
+	if err := checkMaybeJSONReply([]byte(`<html><form action="/login">session expired</form></html>`)); err == nil {
+		t.Fatal("HTTP 200 login HTML is accepted as successful upload/delete/copy/move response")
+	}
+}
